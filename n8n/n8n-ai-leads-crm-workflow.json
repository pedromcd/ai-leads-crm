      "name": "OpenRouter"
    },
    {
      "parameters": {
        "jsCode": "// Extrai o conteúdo do modelo\nconst raw = $json.choices?.[0]?.message?.content || \"\";\n\n// Remove ```json ... ``` caso venha\nconst cleaned = raw\n  .replace(/```json\\s*/i, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\n// Converte para objeto\nlet ai = {};\ntry {\n  ai = JSON.parse(cleaned);\n} catch (e) {\n  ai = {\n    intent: \"General\",\n    priority: \"Medium\",\n    score: 50,\n    next_action: \"Follow up\",\n    suggested_reply: cleaned,\n  };\n}\n\n// Junta com dados do lead (do node Edit Fields)\nconst lead = $node[\"Edit Fields\"].json;\n\nreturn [{\n  ...lead,\n  intent: ai.intent,\n  priority: ai.priority,\n  score: ai.score,\n  next_action: ai.next_action,\n  suggested_reply: ai.suggested_reply\n}];"
      },
