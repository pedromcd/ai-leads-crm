        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"mistralai/mistral-7b-instruct\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Return ONLY valid JSON (no markdown, no backticks). Keys: intent, priority, score, next_action, suggested_reply. intent must be one of: Pricing, Trial, Support, General, Partnership. priority must be one of: Low, Medium, High, Urgent. score must be an integer 0-100. suggested_reply must be a short WhatsApp-style reply in Portuguese.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Name: {{ $json.name }}\\nMessage: {{ $json.message }}\"\n    }\n  ],\n  \"temperature\": 0.3\n}",
        "options": {}
